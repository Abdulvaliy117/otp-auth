SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# В docker-compose DATABASE_URL и REDIS_URL задаются автоматически.

OTP_CODE_TTL=300
OTP_RESEND_COOLDOWN=60
OTP_MAX_ATTEMPTS=5

# По умолчанию письма печатаются в лог (docker compose logs celery).
